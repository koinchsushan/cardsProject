*.prof
*.lprof

# ============================================================================
# Keep These Files
# ============================================================================

# Important: These should NOT be ignored
!.gitignore
!.gitkeep
!README.md
!LICENSE
!requirements.txt
!Procfile
!Dockerfile
!docker-compose.yml
